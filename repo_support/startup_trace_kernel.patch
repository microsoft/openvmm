--- /dev/null
+++ b/drivers/tty/serial/amba-pl011-console.h
@@ -0,0 +1,50 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _AMBA_PL011_CONSOLE_H
+#define _AMBA_PL011_CONSOLE_H
+
+struct pl011_console_tx {
+	unsigned int room;
+	unsigned int capacity;
+	unsigned int status_reads;
+	unsigned int data_writes;
+};
+
+struct pl011_console_tx_ops {
+	unsigned int (*get_room)(void *context, struct pl011_console_tx *tx);
+	void (*write)(void *context, unsigned char ch);
+};
+
+static inline unsigned int
+pl011_console_tx_credit(unsigned int empty, unsigned int full,
+			unsigned int capacity)
+{
+	if (full)
+		return 0;
+	if (empty && capacity)
+		return capacity;
+	return 1;
+}
+
+static inline void
+pl011_console_tx_byte(struct pl011_console_tx *tx,
+		      const struct pl011_console_tx_ops *ops,
+		      void *context, unsigned char ch)
+{
+	if (!tx->room)
+		tx->room = ops->get_room(context, tx);
+	ops->write(context, ch);
+	tx->room--;
+	tx->data_writes++;
+}
+
+static inline void
+pl011_console_tx_char(struct pl011_console_tx *tx,
+		      const struct pl011_console_tx_ops *ops,
+		      void *context, unsigned char ch)
+{
+	if (ch == '\n')
+		pl011_console_tx_byte(tx, ops, context, '\r');
+	pl011_console_tx_byte(tx, ops, context, ch);
+}
+
+#endif
