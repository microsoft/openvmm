+	u64 start;
 
-	while (pl011_read(uap, REG_FR) & UART01x_FR_TXFF)
-		cpu_relax();
+	pl011_console_wait(uap, UART01x_FR_TXFF, 0);
+	start = enabled ? ktime_get_mono_fast_ns() : 0;
 	pl011_write(ch, uap, REG_DR);
+	if (enabled) {
+		u64 ns = ktime_get_mono_fast_ns() - start;
+
+		if (ns >= 50000)
+			trace_slow_write(uap->port.line, ns);
+	}
 	uap->console_line_ended = (ch == '\n');
 }
 
