diff --git a/include/trace/events/uart_console.h b/include/trace/events/uart_console.h
new file mode 100644
index 000000000..a210d4530
--- /dev/null
+++ b/include/trace/events/uart_console.h
@@ -0,0 +1,65 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#undef TRACE_SYSTEM
+#define TRACE_SYSTEM uart_console
+
+#if !defined(_TRACE_UART_CONSOLE_H) || defined(TRACE_HEADER_MULTI_READ)
+#define _TRACE_UART_CONSOLE_H
+
+#include <linux/tracepoint.h>
+
+TRACE_EVENT(record,
+	TP_PROTO(unsigned int port, unsigned int stage, unsigned int atomic,
+		 unsigned int len),
+	TP_ARGS(port, stage, atomic, len),
+	TP_STRUCT__entry(
+		__field(unsigned int, port)
+		__field(unsigned int, stage)
+		__field(unsigned int, atomic)
+		__field(unsigned int, len)
+	),
+	TP_fast_assign(
+		__entry->port = port;
+		__entry->stage = stage;
+		__entry->atomic = atomic;
+		__entry->len = len;
+	),
+	TP_printk("port=%u stage=%u atomic=%u len=%u",
+		  __entry->port, __entry->stage, __entry->atomic, __entry->len)
+);
+
+TRACE_EVENT(wait,
+	TP_PROTO(unsigned int port, unsigned int mask, unsigned int polls, u64 ns),
+	TP_ARGS(port, mask, polls, ns),
+	TP_STRUCT__entry(
+		__field(unsigned int, port)
+		__field(unsigned int, mask)
+		__field(unsigned int, polls)
+		__field(u64, ns)
+	),
+	TP_fast_assign(
+		__entry->port = port;
+		__entry->mask = mask;
+		__entry->polls = polls;
+		__entry->ns = ns;
+	),
+	TP_printk("port=%u mask=0x%x polls=%u ns=%llu",
+		  __entry->port, __entry->mask, __entry->polls, __entry->ns)
+);
+
+TRACE_EVENT(slow_write,
+	TP_PROTO(unsigned int port, u64 ns),
+	TP_ARGS(port, ns),
+	TP_STRUCT__entry(
+		__field(unsigned int, port)
+		__field(u64, ns)
+	),
+	TP_fast_assign(
+		__entry->port = port;
+		__entry->ns = ns;
+	),
+	TP_printk("port=%u ns=%llu", __entry->port, __entry->ns)
+);
+
+#endif
+
+#include <trace/define_trace.h>
