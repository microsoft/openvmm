+static unsigned int pl011_console_wait(struct uart_amba_port *uap,
+				      unsigned int mask, unsigned int invert)
+{
+	bool enabled = trace_wait_enabled();
+	u64 start = enabled ? ktime_get_mono_fast_ns() : 0;
+	unsigned int polls = 0;
+
+	while ((pl011_read(uap, REG_FR) ^ invert) & mask) {
+		polls++;
+		cpu_relax();
+	}
+
+	if (enabled) {
+		u64 ns = ktime_get_mono_fast_ns() - start;
+
+		if (polls || ns >= 50000)
+			trace_wait(uap->port.line, mask, polls, ns);
+	}
+	return polls + 1;
+}
+
+static unsigned int
+pl011_console_get_room(void *context, struct pl011_console_tx *tx)
+{
+	struct uart_amba_port *uap = context;
+	bool enabled = trace_wait_enabled();
+	u64 start = enabled ? ktime_get_mono_fast_ns() : 0;
+	unsigned int polls = 0, flags, room;
+
+	for (;;) {
+		flags = pl011_read(uap, REG_FR);
+		tx->status_reads++;
+		room = pl011_console_tx_credit(flags & UART011_FR_TXFE,
+					       flags & UART01x_FR_TXFF, tx->capacity);
+		if (room)
+			break;
+		polls++;
+		cpu_relax();
+	}
+
+	if (enabled) {
+		u64 ns = ktime_get_mono_fast_ns() - start;
+
+		if (polls || ns >= 50000)
+			trace_wait(uap->port.line, UART01x_FR_TXFF, polls, ns);
+	}
+	return room;
+}
+
+static void pl011_console_write_byte(void *context, unsigned char ch)
+{
+	struct uart_amba_port *uap = context;
+	bool enabled = trace_slow_write_enabled();
+	u64 start = enabled ? ktime_get_mono_fast_ns() : 0;
+
+	pl011_write(ch, uap, REG_DR);
+	if (enabled) {
+		u64 ns = ktime_get_mono_fast_ns() - start;
+
+		if (ns >= 50000)
+			trace_slow_write(uap->port.line, ns);
+	}
+	uap->console_line_ended = (ch == '\n');
+}
+
+static const struct pl011_console_tx_ops pl011_console_tx_ops = {
+	.get_room = pl011_console_get_room,
